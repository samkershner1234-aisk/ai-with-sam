# Server-only environment variables for the AI Time-Waste Audit lead route.
# These are used ONLY by the Vercel serverless function api/ai-time-waste-audit.js.
# Do NOT prefix with VITE_ / NEXT_PUBLIC_ / REACT_APP_ (that would expose them to the browser).
# Do NOT commit real values. Set the real values in the Vercel dashboard:
#   Vercel > Project (ai-with-sam) > Settings > Environment Variables

# Full HTTPS URL of the deployed Google Apps Script web app that stores the lead in Notion.
AI_AUDIT_APPS_SCRIPT_URL=

# Shared secret sent in the request body and verified inside the Apps Script.
AI_AUDIT_SHARED_SECRET=
